import KernelRankLean.TranslationSemigroup

/-!
# Minimal differential annihilators and cyclic translation generators

A cyclic vector identifies a finite-dimensional space with the algebra generated by its
endomorphism. The minimal polynomial's degree is therefore the dimension of the space.
If an exponential orbit spans the space, its starting vector is cyclic.

The translation realization is both reachable and observable. Its generator's minimal
polynomial generates the ideal of constant-coefficient differential annihilators of the profile,
and its degree is the radial kernel's separable rank. Derivatives are taken within `[0, ∞)`,
including right derivatives at zero, so the profile's values at negative arguments are irrelevant.

This gives an additional characterization, not a shorter replacement for the component proof.
-/

open Polynomial Module

namespace KernelRank

attribute [local instance] translateNormedAddCommGroup translateNormedSpace
  translateUniformSpace translateCompleteSpace

variable {𝕜 V : Type*} [Field 𝕜] [AddCommGroup V] [Module 𝕜 V]

/-- A polynomial killing a cyclic vector kills the whole space. -/
lemma aeval_eq_zero_of_cyclic (A : Module.End 𝕜 V) (v : V)
    (hv : Function.Surjective fun p : 𝕜[X] => aeval A p v)
    {p : 𝕜[X]} (hp : aeval A p v = 0) : aeval A p = 0 := by
  ext w
  obtain ⟨q, rfl⟩ := hv w
  rw [← Module.End.mul_apply, ← map_mul, mul_comm p q, map_mul,
    Module.End.mul_apply, hp, map_zero]
  rfl

/-- The operator's minimal polynomial also annihilates its cyclic vector minimally. -/
theorem minpoly_dvd_iff_aeval_cyclic (A : Module.End 𝕜 V) (v : V)
    (hv : Function.Surjective fun p : 𝕜[X] => aeval A p v) (p : 𝕜[X]) :
    minpoly 𝕜 A ∣ p ↔ aeval A p v = 0 :=
  ⟨fun hp => by rw [minpoly.dvd_iff.mp hp, LinearMap.zero_apply],
    fun hp => minpoly.dvd 𝕜 A (aeval_eq_zero_of_cyclic A v hv hp)⟩

/-- For a cyclic endomorphism, minimal-polynomial degree equals the space's dimension. -/
theorem finrank_eq_natDegree_minpoly_of_cyclic [FiniteDimensional 𝕜 V]
    (A : Module.End 𝕜 V) (v : V)
    (hv : Function.Surjective fun p : 𝕜[X] => aeval A p v) :
    Module.finrank 𝕜 V = (minpoly 𝕜 A).natDegree := by
  classical
  let S := Algebra.adjoin 𝕜 {A}
  let e : S →ₗ[𝕜] V :=
    (LinearMap.applyₗ v).comp S.val.toLinearMap
  have he : Function.Bijective e := by
    constructor
    · rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro B hB
      obtain ⟨p, hp⟩ := Algebra.adjoin_eq_exists_aeval 𝕜 A B
      apply Subtype.ext
      exact hp.symm.trans (aeval_eq_zero_of_cyclic A v hv (by simpa [e, hp] using hB))
    · intro w
      obtain ⟨p, rfl⟩ := hv w
      exact ⟨⟨aeval A p, aeval_mem_adjoin_singleton 𝕜 A⟩, rfl⟩
  let a : S := ⟨A, Algebra.self_mem_adjoin_singleton 𝕜 A⟩
  have ha : IsIntegral 𝕜 a :=
    (isIntegral_algHom_iff S.val Subtype.coe_injective).mp
      (Algebra.IsIntegral.isIntegral A)
  have hspan : ⊤ ≤ Submodule.span 𝕜
      (Set.range fun i : Fin (minpoly 𝕜 a).natDegree => a ^ (i : ℕ)) := by
    intro B _
    obtain ⟨p, hp⟩ := Algebra.adjoin_eq_exists_aeval 𝕜 A B
    apply ha.mem_span_pow
    refine ⟨p, ?_⟩
    apply Subtype.ext
    simpa [a, ← aeval_algHom_apply] using hp.symm
  let b := Basis.mk (linearIndependent_pow a) hspan
  calc
    Module.finrank 𝕜 V = Module.finrank 𝕜 S :=
      (LinearEquiv.ofBijective e he).finrank_eq.symm
    _ = (minpoly 𝕜 a).natDegree := by
      rw [Module.finrank_eq_card_basis b, Fintype.card_fin]
    _ = (minpoly 𝕜 A).natDegree := by
      rw [← minpoly.algHom_eq S.val Subtype.coe_injective a]
      rfl

noncomputable section Endomorphism

open NNReal

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [FiniteDimensional ℂ E]

local instance : CompleteSpace E := FiniteDimensional.complete ℂ E
local instance : NormedSpace ℝ E := .restrictScalars ℝ ℂ E
local instance : NormedAlgebra ℝ (E →L[ℂ] E) := .restrictScalars ℝ ℂ _
local instance : NormedAlgebra ℚ (E →L[ℂ] E) := .restrictScalars ℚ ℂ _

/-- Reachability under the exponential implies cyclicity under the generator. -/
theorem cyclic_of_span_exp_eq_top (A : E →L[ℂ] E) (v : E)
    (hv : Submodule.span ℂ
      (Set.range fun t : ℝ≥0 => NormedSpace.exp ((t : ℂ) • A) v) = ⊤) :
    Function.Surjective fun p : ℂ[X] => aeval A.toLinearMap p v := by
  let e : ℂ[X] →ₗ[ℂ] E :=
    (LinearMap.applyₗ v).comp (aeval A.toLinearMap).toLinearMap
  change Function.Surjective e
  apply LinearMap.range_eq_top.mp
  apply top_unique
  rw [← hv]
  refine Submodule.span_le.mpr ?_
  rintro _ ⟨t, rfl⟩
  have hexp : NormedSpace.exp ((t : ℂ) • A) ∈ Algebra.adjoin ℂ {A} :=
    NormedSpace.exp_mem (R := ℂ) (s := Algebra.adjoin ℂ {A})
      (Submodule.closed_of_finiteDimensional
      (Algebra.adjoin ℂ {A}).toSubmodule)
      ((Algebra.adjoin ℂ {A}).smul_mem (Algebra.self_mem_adjoin_singleton ℂ A) (t : ℂ))
  obtain ⟨p, hp⟩ := Algebra.adjoin_mem_exists_aeval ℂ A hexp
  refine ⟨p, ?_⟩
  change aeval ((Module.End.toContinuousLinearMap E).symm A) p v =
    NormedSpace.exp ((t : ℂ) • A) v
  rw [aeval_algHom_apply, ← hp]
  rfl

theorem natDegree_minpoly_eq_finrank_of_span_exp_eq_top (A : E →L[ℂ] E) (v : E)
    (hv : Submodule.span ℂ
      (Set.range fun t : ℝ≥0 => NormedSpace.exp ((t : ℂ) • A) v) = ⊤) :
    (minpoly ℂ A).natDegree = Module.finrank ℂ E := by
  have h := (finrank_eq_natDegree_minpoly_of_cyclic A.toLinearMap v
    (cyclic_of_span_exp_eq_top A v hv)).symm
  change (minpoly ℂ ((Module.End.toContinuousLinearMap E).symm A)).natDegree = _ at h
  rwa [minpoly.algEquiv_eq] at h

noncomputable def operatorOrbit (A : E →L[ℂ] E) (v : E)
    (β : E →L[ℂ] ℂ) (t : ℝ) : ℂ :=
  β (NormedSpace.exp ((t : ℂ) • A) v)

lemma hasDerivAt_operatorOrbit (A : E →L[ℂ] E) (v : E)
    (β : E →L[ℂ] ℂ) (t : ℝ) :
    HasDerivAt (operatorOrbit A v β) (operatorOrbit A (A v) β t) t := by
  let L := (β.comp (ContinuousLinearMap.apply ℂ E v)).restrictScalars ℝ
  exact L.hasFDerivAt.comp_hasDerivAt t (hasDerivAt_exp_smul_const A t)

lemma iteratedDerivWithin_operatorOrbit (A : E →L[ℂ] E) (v : E)
    (β : E →L[ℂ] ℂ) (k : ℕ) {t : ℝ} (ht : 0 ≤ t) :
    iteratedDerivWithin k (operatorOrbit A v β) (Set.Ici 0) t =
      operatorOrbit A ((A ^ k) v) β t := by
  induction k generalizing t with
  | zero => simp [iteratedDerivWithin_zero]
  | succ k ih =>
    rw [iteratedDerivWithin_succ]
    have heq : Set.EqOn
        (iteratedDerivWithin k (operatorOrbit A v β) (Set.Ici 0))
        (operatorOrbit A ((A ^ k) v) β) (Set.Ici 0) := fun u hu => ih hu
    rw [derivWithin_congr heq (heq ht),
      (hasDerivAt_operatorOrbit A ((A ^ k) v) β t).hasDerivWithinAt.derivWithin
        (uniqueDiffOn_Ici 0 t ht), pow_succ', mul_apply_eq_comp]

/-- A constant-coefficient differential operator on the nonnegative half-line. -/
noncomputable def differentialOperator (p : ℂ[X]) (f : ℝ → ℂ) (t : ℝ) : ℂ :=
  ∑ k ∈ Finset.range (p.natDegree + 1),
    p.coeff k * iteratedDerivWithin k f (Set.Ici 0) t

lemma differentialOperator_operatorOrbit (A : E →L[ℂ] E) (v : E)
    (β : E →L[ℂ] ℂ) (p : ℂ[X]) {t : ℝ} (ht : 0 ≤ t) :
    differentialOperator p (operatorOrbit A v β) t =
      operatorOrbit A (aeval A p v) β t := by
  simp only [differentialOperator, iteratedDerivWithin_operatorOrbit A v β _ ht]
  simp [operatorOrbit, aeval_eq_sum_range, map_sum, map_smul, smul_eq_mul]

/-- In a reachable, observable realization, differential annihilation is divisibility by minpoly. -/
theorem differentialOperator_eq_zero_iff_minpoly_dvd (A : E →L[ℂ] E) (v : E)
    (β : E →L[ℂ] ℂ)
    (hreach : Submodule.span ℂ
      (Set.range fun t : ℝ≥0 => NormedSpace.exp ((t : ℂ) • A) v) = ⊤)
    (hobs : ∀ w, (∀ t, 0 ≤ t → operatorOrbit A w β t = 0) → w = 0)
    (p : ℂ[X]) :
    (∀ t, 0 ≤ t → differentialOperator p (operatorOrbit A v β) t = 0) ↔
      minpoly ℂ A ∣ p := by
  have hrewrite :
      (∀ t, 0 ≤ t → differentialOperator p (operatorOrbit A v β) t = 0) ↔
      (∀ t, 0 ≤ t → operatorOrbit A (aeval A p v) β t = 0) := by
    constructor <;> intro h t ht
    · rw [← differentialOperator_operatorOrbit A v β p ht]
      exact h t ht
    · rw [differentialOperator_operatorOrbit A v β p ht]
      exact h t ht
  have hzero : (∀ t, 0 ≤ t → operatorOrbit A (aeval A p v) β t = 0) ↔
      aeval A p v = 0 :=
    ⟨hobs _, fun h t _ => by simp [h, operatorOrbit]⟩
  rw [hrewrite, hzero]
  have h := (minpoly_dvd_iff_aeval_cyclic A.toLinearMap v
    (cyclic_of_span_exp_eq_top A v hreach) p).symm
  change aeval ((Module.End.toContinuousLinearMap E).symm A) p v = 0 ↔
    minpoly ℂ ((Module.End.toContinuousLinearMap E).symm A) ∣ p at h
  rw [aeval_algHom_apply, minpoly.algEquiv_eq] at h
  exact h

end Endomorphism

section Translation

open NNReal

variable (ψ : ℝ → ℂ) [FiniteDimensional ℂ (translateSpan ψ)]

/-- A continuous finite-rank profile has a translation generator whose minimal-polynomial degree
equals the translate-span dimension. -/
theorem exists_generator_minpoly (hψ : ContinuousOn ψ (Set.Ici 0)) :
    ∃ A : translateSpan ψ →L[ℂ] translateSpan ψ,
      (∀ t : ℝ, 0 ≤ t → shiftCLM ψ t = NormedSpace.exp ((t : ℂ) • A)) ∧
        (minpoly ℂ A).natDegree = Module.finrank ℂ (translateSpan ψ) := by
  obtain ⟨A, hA⟩ := exists_translation_generator ψ hψ
  exact ⟨A, hA, natDegree_minpoly_eq_finrank_of_span_exp_eq_top A
    (initialProfile ψ) (reachable_of_generator ψ A hA)⟩

end Translation

section RealProfile

variable (φ : ℝ → ℝ) [FiniteDimensional ℝ (translateSpan φ)]

/-- The least differential-annihilator order is the radial kernel's separable rank. -/
theorem exists_minimal_differential_annihilator (hφ : ContinuousOn φ (Set.Ici 0)) :
    ∃ p : ℂ[X], p.Monic ∧
      separableRank (fun x y => φ (x ^ 2 + y ^ 2)) = p.natDegree ∧
      ∀ q : ℂ[X],
        (∀ t, 0 ≤ t → differentialOperator q (fun s => (φ s : ℂ)) t = 0) ↔ p ∣ q := by
  let ψ : ℝ → ℂ := fun t => (φ t : ℂ)
  let : FiniteDimensional ℂ (translateSpan ψ) := finiteDimensional_translateSpan_ofReal φ
  obtain ⟨A, hA, hdeg⟩ := exists_generator_minpoly ψ
    (Complex.continuous_ofReal.comp_continuousOn hφ)
  let v := initialProfile ψ
  let β := evalW ψ 0
  have heq : Set.EqOn ψ (operatorOrbit A v β) (Set.Ici 0) :=
    fun _ ht => profile_of_generator ψ A hA ht
  have hdiff (q : ℂ[X]) (t : ℝ) (ht : 0 ≤ t) :
      differentialOperator q (fun s => (φ s : ℂ)) t =
        differentialOperator q (operatorOrbit A v β) t := by
    unfold differentialOperator
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [iteratedDerivWithin_congr heq ht]
  refine ⟨minpoly ℂ A, minpoly.monic (Algebra.IsIntegral.isIntegral A), ?_, ?_⟩
  · rw [separableRank_radial_eq_finrank, hdeg, finrank_translateSpan_ofReal φ]
  · intro q
    have h := differentialOperator_eq_zero_iff_minpoly_dvd A v β
      (reachable_of_generator ψ A hA) (observable_of_generator ψ A hA) q
    constructor
    · intro hq
      apply h.mp
      intro t ht
      rw [← hdiff q t ht]
      exact hq t ht
    · intro hq t ht
      rw [hdiff q t ht]
      exact h.mpr hq t ht

/-- No nonzero constant-coefficient annihilator has order below the radial kernel's rank. -/
theorem separableRank_radial_le_natDegree_of_annihilator
    (hφ : ContinuousOn φ (Set.Ici 0)) {q : ℂ[X]} (hq : q ≠ 0)
    (hann : ∀ t, 0 ≤ t → differentialOperator q (fun s => (φ s : ℂ)) t = 0) :
    separableRank (fun x y => φ (x ^ 2 + y ^ 2)) ≤ q.natDegree := by
  obtain ⟨p, _, hrank, hp⟩ := exists_minimal_differential_annihilator φ hφ
  rw [hrank]
  exact_mod_cast natDegree_le_of_dvd ((hp q).mp hann) hq

end RealProfile

end KernelRank
