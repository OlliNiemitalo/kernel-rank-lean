#!/usr/bin/env bash
# Prints physical and nonblank line counts of a line range of a file.
#
#   scripts/count-lines FILE [FIRST LAST]
file="$1" first="${2:-1}" last="${3:-\$}"
sed -n "${first},${last}p" "$file" |
  awk '{p++} /[^ \t]/ {n++} END {printf "%s %s-%s: %d physical, %d nonblank\n", FILENAME, f, l, p, n}' \
    f="$first" l="$last" FILENAME="$file"
