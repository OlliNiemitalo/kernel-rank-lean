#!/usr/bin/env python3
"""Inspects aiXiv official reviews and author replies, checks that all reviews have
author replies, or posts a new author reply from a Markdown file.

Usage:
  scripts/aixiv-reviews [AIXIV_ID]
  scripts/aixiv-reviews --check-replied [AIXIV_ID]
  scripts/aixiv-reviews --reply REVIEW_ID MARKDOWN_FILE
"""
from __future__ import annotations

import json
import os
import pathlib
import subprocess
import sys
import tempfile

DEFAULT_AIXIV_ID = "aixiv.261111.000007"
REPO = pathlib.Path(__file__).resolve().parent.parent


def curl_json(args: list[str]) -> object | None:
    proc = subprocess.run(["curl", "-fsSL", *args], text=True, capture_output=True)
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    return json.loads(proc.stdout)


def list_reviews(aixiv_id: str) -> list[tuple[str, int, list[int]]]:
    found: list[tuple[str, int, list[int]]] = []
    empty_streak = 0
    for minor in range(0, 50):
        ver = f"1.{minor}"
        data = curl_json(
            [
                "-X", "POST", "https://aixiv.science/api/get-review",
                "-H", "Content-Type: application/json",
                "-d", json.dumps({"aixiv_id": aixiv_id, "version": ver}),
            ]
        )
        rlist = data.get("review_list", []) if isinstance(data, dict) else []
        if not rlist:
            empty_streak += 1
            if empty_streak >= 3:
                break
            continue
        empty_streak = 0
        for rev in rlist:
            rid = int(rev["id"])
            reps_raw = curl_json([f"https://aixiv.science/api/reviews/{rid}/replies"])
            reps = reps_raw if isinstance(reps_raw, list) else (
                reps_raw.get("replies", []) if isinstance(reps_raw, dict) else []
            )
            found.append((ver, rid, [int(r["id"]) for r in reps if "id" in r]))
    return found


def post_reply(review_id: int, md_path: pathlib.Path) -> None:
    token = os.environ.get("AIXIV_GITHUB_COPILOT_TOKEN") or os.environ.get("AIXIV_GITUB_COPILOT_TOKEN")
    if not token:
        print("error: AIXIV_GITHUB_COPILOT_TOKEN is not set", file=sys.stderr)
        sys.exit(1)
    body = md_path.read_text().strip()
    if not body:
        print(f"error: reply file {md_path} is empty", file=sys.stderr)
        sys.exit(1)
    tmp_dir = REPO / ".tmp"
    tmp_dir.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", dir=tmp_dir, suffix=".json", delete=False) as f:
        json.dump({"body": body}, f)
        payload = pathlib.Path(f.name)
    try:
        out = subprocess.check_output(
            [
                "curl", "-fsS", "-X", "POST",
                f"https://aixiv.science/api/reviews/{review_id}/replies",
                "-H", f"Authorization: Bearer {token}",
                "-H", "Content-Type: application/json",
                "-d", f"@{payload}",
            ],
            text=True,
        )
        resp = json.loads(out)
        print(f"posted reply id={resp.get('id')} on review_id={review_id}")
    finally:
        payload.unlink(missing_ok=True)


def main(argv: list[str]) -> None:
    if len(argv) >= 2 and argv[1] == "--reply":
        if len(argv) != 4:
            print("usage: scripts/aixiv-reviews --reply REVIEW_ID MARKDOWN_FILE", file=sys.stderr)
            sys.exit(2)
        post_reply(int(argv[2]), pathlib.Path(argv[3]))
        return

    check_only = False
    args = argv[1:]
    if args and args[0] == "--check-replied":
        check_only = True
        args = args[1:]
    if len(args) > 1:
        print("usage: scripts/aixiv-reviews [--check-replied] [AIXIV_ID]", file=sys.stderr)
        sys.exit(2)
    aixiv_id = args[0] if args else DEFAULT_AIXIV_ID

    reviews = list_reviews(aixiv_id)
    unreplied: list[tuple[str, int]] = []
    for ver, rid, rep_ids in reviews:
        print(f"v{ver}: review_id={rid} replies={rep_ids}")
        if not rep_ids:
            unreplied.append((ver, rid))

    if check_only and unreplied:
        missing = ", ".join(f"v{v} (review {rid})" for v, rid in unreplied)
        print(
            f"error: unreplied official review(s) on {aixiv_id}: {missing}\n"
            "Post an author reply with `scripts/aixiv-reviews --reply <ID> <FILE>` "
            "before uploading a new version (or pass --allow-unreplied to scripts/submit-aixiv).",
            file=sys.stderr,
        )
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv)
