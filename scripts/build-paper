#!/usr/bin/env bash
# Compiles paper/main.tex to paper/main.pdf using a static Tectonic binary in .tmp/bin.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/env.sh"
cd "$repo"

tectonic_bin="$tmp/bin/tectonic"
tectonic_ver="0.15.0"

if [ ! -x "$tectonic_bin" ]; then
  mkdir -p "$tmp/bin"
  arch="$(uname -m)"
  curl -fsSL \
    "https://github.com/tectonic-typesetting/tectonic/releases/download/tectonic%40${tectonic_ver}/tectonic-${tectonic_ver}-${arch}-unknown-linux-musl.tar.gz" \
    | tar -xz -C "$tmp/bin"
fi

outdir="paper"
if [ "${1:-}" = "--outdir" ]; then
  [ -n "${2:-}" ] || { echo "usage: scripts/build-paper [--outdir DIR]" >&2; exit 2; }
  outdir="$2"
  shift 2
fi
[ $# -eq 0 ] || { echo "usage: scripts/build-paper [--outdir DIR]" >&2; exit 2; }
mkdir -p "$outdir"

"$tectonic_bin" -X compile paper/main.tex --outdir "$outdir"
